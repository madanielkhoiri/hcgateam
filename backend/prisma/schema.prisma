// ==================================================
// SURAT TUGAS DINAS (R & D)
// ==================================================

enum StatusSuratTugas {
  MENUNGGU_SH
  MENUNGGU_PJO
  DISETUJUI
  DITOLAK
}

model SuratTugasDinas {
  id                 Int              @id @default(autoincrement())
  nomor              String           @unique
  tujuanLokasi       String           @map("tujuan_lokasi")
  tanggalMulai       DateTime         @map("tanggal_mulai") @db.Date
  tanggalSelesai     DateTime         @map("tanggal_selesai") @db.Date
  keteranganTugas    String           @map("keterangan_tugas") @db.Text
  status             StatusSuratTugas @default(MENUNGGU_SH)
  filePdf            String?          @map("file_pdf")
  dibuatOlehId       Int              @map("dibuat_oleh_id")
  disetujuiShOlehId  Int?             @map("disetujui_sh_oleh_id")
  disetujuiShPada    DateTime?        @map("disetujui_sh_pada")
  disetujuiPjoOlehId Int?             @map("disetujui_pjo_oleh_id")
  disetujuiPjoPada   DateTime?        @map("disetujui_pjo_pada")
