  penerima User? @relation("PenerimaNotifikasiMcu", fields: [penerimaId], references: [id], onDelete: Cascade)

  @@index([tipe])
  @@index([penerimaId])
  @@index([statusKirim])
  @@index([refTabel, refId])
  @@index([createdAt])
  @@map("log_notifikasi_mcu")
