  urutan       Int
  nrp          String
  nama         String
  departemen   String
  jabatan      String

  suratTugas SuratTugasDinas @relation(fields: [suratTugasId], references: [id], onDelete: Cascade)

  @@index([suratTugasId])
  @@map("surat_tugas_karyawan")
}

// ==================================================
// DATABASE ANAK MAGANG + SURAT BALASAN / PENOLAKAN (R & D)
// ==================================================

enum StatusAnakMagang {
  AKTIF
  NONAKTIF
}

model AnakMagang {
  id                 Int              @id @default(autoincrement())
  nrp                String?
  nama               String
  gender             String?
  universitas        String?
  jurusan            String?
  maritalStatus      String?          @map("marital_status")
  agama              String?
  departemen         String?
  jabatan            String?
  posisi             String?
  tempatLahir        String?          @map("tempat_lahir")
  tanggalLahir       DateTime?        @map("tanggal_lahir") @db.Date
  pendidikan         String?
  tanggalMulai       DateTime?        @map("tanggal_mulai") @db.Date
  tanggalSelesai     DateTime?        @map("tanggal_selesai") @db.Date
  email              String?
  noHp               String?          @map("no_hp")
  noKtp              String?          @map("no_ktp")
  npwp               String?
  nomorRekening      String?          @map("nomor_rekening")
  bank               String?
  namaRekening       String?          @map("nama_rekening")
  alamat             String?          @db.Text
  site               String?
  golonganDarah      String?          @map("golongan_darah")
  bpjsTk             String?          @map("bpjs_tk")
  bpjsKesehatan      String?          @map("bpjs_kesehatan")
  tanggalMcu         DateTime?        @map("tanggal_mcu") @db.Date
  tanggalPemeriksaan DateTime?        @map("tanggal_pemeriksaan") @db.Date
  tanggalInduksi     DateTime?        @map("tanggal_induksi") @db.Date
  ukuranBaju         String?          @map("ukuran_baju")
  ukuranCelana       String?          @map("ukuran_celana")
  ukuranSepatu       String?          @map("ukuran_sepatu")
  noKk               String?          @map("no_kk")
  rekomendasi        String?
  atasanLangsung     String?          @map("atasan_langsung")
  status             StatusAnakMagang @default(AKTIF)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  suratBalasanBaris SuratBalasanMagangBaris[]
  suratPenolakan    SuratPenolakanMagang[]

  @@index([status])
  @@map("anak_magang")
}

model SuratBalasanMagang {
  id                Int      @id @default(autoincrement())
  nomor             String   @unique
  nomorUrut         Int      @map("nomor_urut")
  tahunTerbit       Int      @map("tahun_terbit")
  nomorSuratMasuk   String?  @map("nomor_surat_masuk")
  perihalSuratMasuk String?  @map("perihal_surat_masuk")
  tujuanJurusan     String   @map("tujuan_jurusan")
  kotaTujuan        String   @map("kota_tujuan")
  filePdf           String?  @map("file_pdf")
  dibuatOlehId      Int      @map("dibuat_oleh_id")
  createdAt         DateTime @default(now()) @map("created_at")

  dibuatOleh User                      @relation("PembuatSuratBalasanMagang", fields: [dibuatOlehId], references: [id], onDelete: Restrict)
  baris      SuratBalasanMagangBaris[]

  @@index([tahunTerbit])
  @@map("surat_balasan_magang")
}

model SuratBalasanMagangBaris {
  id               Int      @id @default(autoincrement())
  suratId          Int      @map("surat_id")
  anakMagangId     Int      @map("anak_magang_id")
  urutan           Int
  nama             String
  nrp              String
  jurusan          String
  departemenTujuan String   @map("departemen_tujuan")
  tanggalMulai     DateTime @map("tanggal_mulai") @db.Date
  tanggalSelesai   DateTime @map("tanggal_selesai") @db.Date

  surat      SuratBalasanMagang @relation(fields: [suratId], references: [id], onDelete: Cascade)
  anakMagang AnakMagang         @relation(fields: [anakMagangId], references: [id], onDelete: Restrict)

  @@index([suratId])
  @@map("surat_balasan_magang_baris")
}

model SuratPenolakanMagang {
  id              Int      @id @default(autoincrement())
  nomor           String   @unique
  nomorUrut       Int      @map("nomor_urut")
  tahunTerbit     Int      @map("tahun_terbit")
  anakMagangId    Int      @map("anak_magang_id")
  nama            String
  sapaan          String
  alasanPenolakan String   @map("alasan_penolakan") @db.Text
  filePdf         String?  @map("file_pdf")
  dibuatOlehId    Int      @map("dibuat_oleh_id")
  createdAt       DateTime @default(now()) @map("created_at")

  anakMagang AnakMagang @relation(fields: [anakMagangId], references: [id], onDelete: Restrict)
  dibuatOleh User       @relation("PembuatSuratPenolakanMagang", fields: [dibuatOlehId], references: [id], onDelete: Restrict)

  @@index([tahunTerbit])
  @@map("surat_penolakan_magang")
}

// ==================================================
// E-PROM: TENDER, KONTRAK & PROJECT AREA (CIVIL PROJECT)
// Digitalisasi Tender, Kontrak, Project Area, Meeting Progress,
// Dokumen, Financial Monitoring & Project Closing untuk proyek Civil Infras.
// Referensi alur: alur-workflow-tender-kontrak-project-area.md
//
// Catatan implementasi fase ini: seluruh tabel di bawah dibuat sekaligus
// agar struktur data lengkap sesuai ERD, tapi hanya modul Vendor, Tender
// dan Kontrak yang punya backend/frontend aktif pada fase ini. Modul
// Project Area, Meeting Progress, Dokumen, Financial & Project Closing
// baru berupa tabel kosong, menyusul di sesi pengembangan berikutnya.
// ==================================================

enum StatusLegalitasVendor {
  BELUM_LENGKAP
  LENGKAP
}

enum StatusTender {
  PERSIAPAN
  UNDANGAN_TERKIRIM
  EVALUASI_SPH
  SELESAI
}

enum ScopeDocumentFolder {
  TENDER_DOKUMEN
  LEGALITAS_VENDOR
}

enum TipeFileEprom {
  PDF
  RAB
  CAD
  FOTO
}

/**
 * Status approve/reject Owner atas submission Vendor di Project Area (bagian 3.1 dokumen alur).
 */
enum StatusApprovalEprom {
  PENDING
  APPROVED
  REJECTED
}

enum TipeLinkMeeting {
  MINGGUAN
  BULANAN
}

enum TipeDokumenSurat {
  SURAT_TEGURAN
  SURAT_PERINGATAN
  COACHING_COUNSELING
  MEMO
}

// --------------------------------------------------
// VENDOR
// --------------------------------------------------

model Vendor {
  id              Int                   @id @default(autoincrement())
  namaVendor      String                @map("nama_vendor")
  email           String?
  noTelepon       String?               @map("no_telepon")
  /**
   * Vendor non-aktif tidak muncul di pilihan Undangan Tender.
   */
  statusAktif     Boolean               @default(true) @map("status_aktif")
  legalitasStatus StatusLegalitasVendor @default(BELUM_LENGKAP) @map("legalitas_status")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  users           User[]
  undanganTender  TenderUndangan[]
  sph             TenderSPH[]
  kontrak         Kontrak[]
  documentFolders DocumentFolder[]
  evaluasiVendor  EvaluasiVendor[]

  @@map("eprom_vendors")
}

// --------------------------------------------------
// TENDER
// --------------------------------------------------

model TenderProcess {
  id             Int          @id @default(autoincrement())
  namaTender     String       @map("nama_tender")
  status         StatusTender @default(PERSIAPAN)
  tanggalMulai   DateTime?    @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime?    @map("tanggal_selesai") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  documentFolders DocumentFolder[]
  undangan        TenderUndangan[]
  sph             TenderSPH[]
  evaluasiVendor  EvaluasiVendor[]
  kontrak         Kontrak?

  @@map("eprom_tender_process")
}

/**
 * Evaluasi vendor — satu baris per (tender, vendor), gabungan 2 penilaian:
 * 1) Eksternal — 7 kategori tetap, tiap kategori diisi kode 1-4 yang
 *    dipetakan ke bobot % (lihat KODE_EVALUASI_VENDOR di
 *    eprom-evaluasi-vendor.service.ts). Nilai Avg dihitung on-the-fly.
 * 2) Teknis — 5 kriteria berbobot tetap (Teknikal 25%, Schedule 20%, Harga
 *    Penawaran 20%, SHE 20%, Legalitas Perusahaan 15%), sebagian kriteria
 *    punya sub-item (input skor bebas/desimal). Nilai & Round dihitung
 *    on-the-fly, lihat BOBOT_KRITERIA_TEKNIS di service yang sama.
 * Keduanya jadi pertimbangan Owner (bersama SPH) untuk memilih pemenang
 * tender secara manual di tab "Klasifikasi & Evaluasi".
 */
model EvaluasiVendor {
  id               Int      @id @default(autoincrement())
  tenderId         Int      @map("tender_id")
  vendorId         Int      @map("vendor_id")
  bumdesKode       Int?     @map("bumdes_kode")
  bupatiDprKode    Int?     @map("bupati_dpr_kode")
  lingkunganKode   Int?     @map("lingkungan_kode")
  pekerjaLokalKode Int?     @map("pekerja_lokal_kode")
  kepolisianKode   Int?     @map("kepolisian_kode")
  dlhKode          Int?     @map("dlh_kode")
  dpuprKode        Int?     @map("dpupr_kode")

  teknikalMetode      Decimal? @map("teknikal_metode") @db.Decimal(4, 2)
  teknikalAlatKerja   Decimal? @map("teknikal_alat_kerja") @db.Decimal(4, 2)
  teknikalSpesifikasi Decimal? @map("teknikal_spesifikasi") @db.Decimal(4, 2)
  teknikalPengalaman  Decimal? @map("teknikal_pengalaman") @db.Decimal(4, 2)
  teknikalKomunikatif Decimal? @map("teknikal_komunikatif") @db.Decimal(4, 2)
  scheduleSkor        Decimal? @map("schedule_skor") @db.Decimal(4, 2)
  hargaKetepatanWaktu Decimal? @map("harga_ketepatan_waktu") @db.Decimal(4, 2)
  hargaNegosiasi      Decimal? @map("harga_negosiasi") @db.Decimal(4, 2)
  sheSkor             Decimal? @map("she_skor") @db.Decimal(4, 2)
  legalitasSkor       Decimal? @map("legalitas_skor") @db.Decimal(4, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tender TenderProcess @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([tenderId, vendorId])
  @@map("eprom_evaluasi_vendor")
}

model TenderUndangan {
  id           Int       @id @default(autoincrement())
  tenderId     Int       @map("tender_id")
  vendorId     Int       @map("vendor_id")
  fileUndangan String?   @map("file_undangan")
  tanggalKirim DateTime? @map("tanggal_kirim")
  createdAt    DateTime  @default(now()) @map("created_at")

  tender TenderProcess @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([tenderId, vendorId])
  @@map("eprom_tender_undangan")
}

model TenderSPH {
  id             Int      @id @default(autoincrement())
  tenderId       Int      @map("tender_id")
  vendorId       Int      @map("vendor_id")
  roundKe        Int      @map("round_ke")
  fileSph        String?  @map("file_sph")
  hargaPenawaran Decimal? @map("harga_penawaran") @db.Decimal(18, 2)
  isFinal        Boolean  @default(false) @map("is_final")
  statusPemenang Boolean  @default(false) @map("status_pemenang")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tender TenderProcess @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([tenderId, vendorId, roundKe])
  @@map("eprom_tender_sph")
}

// --------------------------------------------------
// DOKUMEN (folder/file ala Google Drive)
// Dipakai bersama oleh Upload Dokumen Tender & Legalitas Vendor.
// --------------------------------------------------

model DocumentFolder {
  id             Int                 @id @default(autoincrement())
  scope          ScopeDocumentFolder
  tenderId       Int?                @map("tender_id")
  vendorId       Int?                @map("vendor_id")
  namaFolder     String              @map("nama_folder")
  parentFolderId Int?                @map("parent_folder_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tender       TenderProcess?   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  parentFolder DocumentFolder?  @relation("FolderChildren", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children     DocumentFolder[] @relation("FolderChildren")
  files        FileUpload[]

  @@index([tenderId])
  @@index([vendorId])
  @@index([parentFolderId])
  @@map("eprom_document_folders")
}

model FileUpload {
  id           Int           @id @default(autoincrement())
  folderId     Int           @map("folder_id")
  namaFile     String        @map("nama_file")
  tipeFile     TipeFileEprom @map("tipe_file")
  urlFile      String        @map("url_file")
  uploadedById Int           @map("uploaded_by")
  uploadedAt   DateTime      @default(now()) @map("uploaded_at")

  folder     DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("EpromFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([folderId])
  @@map("eprom_file_uploads")
}

// --------------------------------------------------
// KONTRAK
// --------------------------------------------------

model Kontrak {
  id             Int      @id @default(autoincrement())
  tenderId       Int      @unique @map("tender_id")
  vendorId       Int      @map("vendor_id")
  nomorKontrak   String   @map("nomor_kontrak")
  fileKontrak    String?  @map("file_kontrak")
  tanggalMulai   DateTime @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime @map("tanggal_selesai") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tender  TenderProcess @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  vendor  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project Project[]

  @@map("eprom_kontrak")
}

// --------------------------------------------------
// PROJECT AREA
// --------------------------------------------------

model Project {
  id          Int      @id @default(autoincrement())
  kontrakId   Int      @map("kontrak_id")
  namaProject String   @map("nama_project")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kontrak Kontrak @relation(fields: [kontrakId], references: [id], onDelete: Restrict)

  shopDrawings              ShopDrawing[]
  materialApprovals         MaterialApproval[]
  metodePekerjaan           MetodePekerjaan[]
  sertifikasiPekerjaan      SertifikasiPekerjaan[]
  peralatanList             PeralatanList[]
  checklistKonstruksi       ChecklistKonstruksi[]
  inspeksiAreaPekerjaan     InspeksiAreaPekerjaan[]
  inspeksiPeralatan         InspeksiPeralatan[]
  progressHarian            ProgressHarian[]
  progressMingguan          ProgressMingguan[]
  progressBulanan           ProgressBulanan[]
  tta                       TTA[]
  kta                       KTA[]
  ibpr                      IBPR[]
  jsa                       JSA[]
  meetings                  Meeting[]
  dokumenSurat              DokumenSurat[]
  opnamePekerjaan           OpnamePekerjaan[]
  asBuildDrawing            AsBuildDrawing[]
  komisioning               Komisioning[]
  serahTerima               SerahTerima[]
  masaPemeliharaanChecklist MasaPemeliharaanChecklist[]
  baSerahTerima             BASerahTerima[]

  @@map("eprom_projects")
}

// -------- Engineer --------

model ShopDrawing {
  id            Int                 @id @default(autoincrement())
  projectId     Int                 @map("project_id")
  namaPekerjaan String              @map("nama_pekerjaan")
  fileUrl       String?             @map("file_url")
  status        StatusApprovalEprom @default(PENDING)
  komentar      String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("eprom_shop_drawings")
}

model MaterialApproval {
  id           Int                 @id @default(autoincrement())
  projectId    Int                 @map("project_id")
  namaMaterial String              @map("nama_material")
  fileUrl      String?             @map("file_url")
  status       StatusApprovalEprom @default(PENDING)
  komentar     String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("eprom_material_approvals")
}

model MetodePekerjaan {
  id         Int                 @id @default(autoincrement())
  projectId  Int                 @map("project_id")
  namaMetode String              @map("nama_metode")
  fileUrl    String?             @map("file_url")
  status     StatusApprovalEprom @default(PENDING)
  komentar   String?             @db.Text
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

