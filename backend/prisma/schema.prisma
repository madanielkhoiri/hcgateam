// -------- Meeting Progress --------

model Meeting {
  id             Int             @id @default(autoincrement())
  projectId      Int             @map("project_id")
  tipeLink       TipeLinkMeeting @map("tipe_link")
  refProgressId  Int?            @map("ref_progress_id")
  tanggalMeeting DateTime?       @map("tanggal_meeting") @db.Date
  createdAt      DateTime        @default(now()) @map("created_at")

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dokumentasi DokumentasiMeeting[]
  mom         MOM[]

  @@index([projectId])
  @@map("eprom_meetings")
}

model DokumentasiMeeting {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  fileFoto  String?  @map("file_foto")
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("eprom_dokumentasi_meeting")
}

/**
 * hariTerlambat dibekukan saat statusClose = true, lihat bagian 5.3.3.
 */
model MOM {
  id            Int       @id @default(autoincrement())
  meetingId     Int       @map("meeting_id")
  pica          String    @db.Text
  dueDate       DateTime  @map("due_date") @db.Date
  pic           String
  statusClose   Boolean   @default(false) @map("status_close")
  tglClose      DateTime? @map("tgl_close") @db.Date
  fileFotoClose String?   @map("file_foto_close")
  hariTerlambat Int?      @map("hari_terlambat")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("eprom_mom")
}

