generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FA
  SECTION_HEAD
  GRUP_LEADER
  KARYAWAN
  VENDOR
  TAMU
  // Peran khusus alur MCU Periodik (Bagian 2 alur-workflow-mcu-periodik-v3.md).
  // Satu akun = satu role, tidak ada peran ganda.
  ADMIN_DEPT
  HC
  DOKTER
  SHE
  KLINIK
  // Admin Compensation & Benefit.
  ADMIN_COMBEN
  // Project Manager - penyetuju tahap 2 Surat Tugas Dinas (setelah SH).
  PJO
  // Peran khusus modul e-ProM (Civil Project). Akses penuh di dalam
  // modul e-ProM saja, bukan bypass admin portal secara umum.
  // Referensi: alur-workflow-tender-kontrak-project-area.md
  OWNER
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  username           String?  @unique
  nrp                String?  @unique
  email              String?  @unique
  phoneNumber        String?  @map("phone_number")
  passwordHash       String   @map("password_hash")
  role               UserRole @default(KARYAWAN)
  isActive           Boolean  @default(true) @map("is_active")
  accessKeys         String[] @default([]) @map("access_keys")
  signatureImage     String?  @map("signature_image")
  twoFactorSecret    String?  @map("two_factor_secret")
  isTwoFactorEnabled Boolean  @default(false) @map("is_two_factor_enabled")
  vendorId           Int?     @map("vendor_id")
  ticketCode         String?  @map("kode_tiket")
  vendor             Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  departemen         String?
  jabatan            String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workOrders WorkOrder[]
  handovers  Handover[]

  dailyActivities   DailyActivity[]         @relation("DailyActivityCreator")
  dailyProgresses   DailyActivityProgress[] @relation("DailyProgressCreator")
  dailyApprovals    DailyActivityApproval[] @relation("DailyApprovalActor")
  preActivityChecks PreActivityCheck[]      @relation("PreActivityCheckCreator")
  postActivities    PostActivity[]          @relation("PostActivityCreator")

  p5mMeetings      P5mMeeting[]      @relation("P5mMeetingCreator")
  preActivities    PreActivity[]     @relation("PreActivityCreator")
  safetyMeetings   SafetyMeeting[]
  transportRecords TransportRecord[] @relation("TransportRecordCreator")
  packMealOrders   PackMealOrder[]   @relation("PackMealOrderCreator")

  profilKaryawan     Karyawan?
  departemenDikelola Departemen[]       @relation("AdminDepartemen")
  klinikDikelola     Klinik[]           @relation("AkunKlinik")
  jadwalMcuDibuat    JadwalMcu[]        @relation("PembuatJadwalMcu")
  jadwalMcuDiubah    JadwalMcu[]        @relation("PengubahJadwalMcu")
  suratPengantarMcu  SuratPengantar[]   @relation("PenerbitSuratPengantar")
  hasilMcuDiupload   HasilMcu[]         @relation("PengunggahHasilMcu")
  rekomendasiMcu     RekomendasiMcu[]   @relation("DokterRekomendasi")
  batasFollowUp      FollowUp[]         @relation("PenetapBatasFollowUp")
  hasilFollowUp      HasilFollowUp[]    @relation("PengunggahHasilFollowUp")
  induksiUlangPic    InduksiUlang[]     @relation("PicSheInduksi")
  notifikasiMcu      LogNotifikasiMcu[] @relation("PenerimaNotifikasiMcu")

  tiketHelpdeskDibuat   TiketHelpdesk[] @relation("PembuatTiketHelpdesk")
  tiketHelpdeskDiproses TiketHelpdesk[] @relation("PicTiketHelpdesk")

  suratTugasDibuat       SuratTugasDinas[] @relation("PembuatSuratTugas")
  suratTugasDisetujuiSh  SuratTugasDinas[] @relation("PenyetujuShSuratTugas")
  suratTugasDisetujuiPjo SuratTugasDinas[] @relation("PenyetujuPjoSuratTugas")

  suratBalasanMagangDibuat   SuratBalasanMagang[]   @relation("PembuatSuratBalasanMagang")
  suratPenolakanMagangDibuat SuratPenolakanMagang[] @relation("PembuatSuratPenolakanMagang")

  epromFileUploads FileUpload[] @relation("EpromFileUploader")

  @@map("users")
}

// ==================================================
// KATEGORI BARANG
// ==================================================

enum InventoryScope {
  GENERAL
  MESS
  ELECTRIC
}

enum ItemCategory {
  ATK
  HOUSEKEEPING
  BAJU
}

// ==================================================
// SATUAN BARANG
// ==================================================

enum ItemUnit {
  BATANG
  BOTOL
  BUAH
  CM
  DERIJEN
  DUS
  KARUNG
  KG
  KOLI
  KOTAK
  LEMBAR
  LITER
  LUSI
  M2
  M3
  METER
  MM
  PAC
  PC
  RET
  RIM
  ROLL
  SAK
  SET
  TABUNG
  TUBE
  UNIT
}

// ==================================================
// MASTER BARANG
// ==================================================

model Item {
  id             Int            @id @default(autoincrement())
  code           String
  name           String
  inventoryScope InventoryScope @default(GENERAL) @map("inventory_scope")
  category       ItemCategory
  unit           ItemUnit       @default(PC)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  stock     InventoryStock?
  stockIns  StockIn[]
  stockOuts StockOut[]

  @@unique([inventoryScope, code])
  @@index([inventoryScope])
  @@index([inventoryScope, category])
  @@index([category])
  @@index([name])
  @@map("items")
}

// ==================================================
// STOK BARANG
// Satu master barang hanya memiliki satu baris stok
// ==================================================

model InventoryStock {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique @map("item_id")
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_stocks")
}

// ==================================================
// BARANG MASUK
// ==================================================

model StockIn {
  id        Int          @id @default(autoincrement())
  date      DateTime     @db.Date
  itemId    Int          @map("item_id")
  category  ItemCategory
  quantity  Int
  unit      ItemUnit
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([itemId])
  @@map("stock_ins")
}

// ==================================================
// BARANG KELUAR
// ==================================================

model StockOut {
  id          Int          @id @default(autoincrement())
  date        DateTime     @db.Date
  itemId      Int          @map("item_id")
  category    ItemCategory
  quantity    Int
  unit        ItemUnit
  taker       String
  department  String?
  description String?      @db.Text
  photoPath   String?      @map("photo_path")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([itemId])
  @@index([department])
  @@map("stock_outs")
}

enum WorkOrderStatus {
  OPEN
  ON_PROGRESS
  CLOSE
}

enum WorkOrderPriority {
  P1
  P2
}

enum WorkOrderPic {
  GA_INFRAS
  GA_ELECTRIC
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  workOrderNumber    String            @unique @map("work_order_number")
  sequenceNumber     Int               @unique @map("sequence_number")
  workOrderName      String            @map("work_order_name")
  department         String
  position           String?
  pic                WorkOrderPic      @default(GA_INFRAS)
  jobType            String            @map("job_type")
  userDepartmentName String            @map("user_department_name")
  description        String            @db.Text
  location           String?
  requestedAt        DateTime          @map("requested_at") @db.Date
  status             WorkOrderStatus   @default(OPEN)
  priority           WorkOrderPriority @default(P2)
  closedAt           DateTime?         @map("closed_at")
  closedDurationDays Int?              @map("closed_duration_days")
  imagePaths         String[]          @default([]) @map("image_paths")
  createdBy          Int               @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  handover Handover?

  @@index([status])
  @@index([requestedAt])
  @@index([department])
  @@index([pic])
  @@map("work_orders")
}

model Handover {
  id                 Int      @id @default(autoincrement())
  stpNumber          String   @unique @map("stp_number")
  sequenceNumber     Int      @unique @map("sequence_number")
  workOrderId        Int      @unique @map("work_order_id")
  handoverDate       DateTime @map("handover_date") @db.Date
  receiverName       String?  @map("receiver_name")
  receiverPosition   String?  @map("receiver_position")
  receiverDepartment String?  @map("receiver_department")
  location           String?
  handoverNote       String?  @map("handover_note") @db.Text
  documentationPaths String[] @default([]) @map("documentation_paths")
  autoCreated        Boolean  @default(false) @map("auto_created")
  createdBy          Int      @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([handoverDate])
  @@index([receiverDepartment])
  @@map("handovers")
}

// ==================================================
// DAILY ACTIVITY DAN POTONG RUMPUT
// ==================================================

enum DailyActivityType {
  DAILY_ACTIVITY
  GRASS_CUTTING
}

enum DailyActivityStatus {
  OPEN
  ON_PROGRESS
  WAITING_APPROVAL
  CLOSE
}

enum DailyApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum DailyApprovalDecision {
  APPROVED
  REJECTED
}

model DailyActivity {
  id                    Int                 @id @default(autoincrement())
  activityType          DailyActivityType   @default(DAILY_ACTIVITY) @map("activity_type")
  startDate             DateTime            @map("start_date") @db.Date
  lastProgressDate      DateTime?           @map("last_progress_date") @db.Date
  workName              String              @map("work_name")
  location              String
  description           String?             @db.Text
  profilePhotoPath      String              @map("profile_photo_path")
  preActivityPhotoPaths String[]            @default([]) @map("pre_activity_photo_paths")
  currentProgress       Int                 @default(0) @map("current_progress")
  lastPic               String?             @map("last_pic")
  status                DailyActivityStatus @default(OPEN)
  approvalStatus        DailyApprovalStatus @default(NONE) @map("approval_status")
  closeRequestedAt      DateTime?           @map("close_requested_at")
  closedAt              DateTime?           @map("closed_at")
  createdBy             Int                 @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  creator           User                    @relation("DailyActivityCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  progressHistories DailyActivityProgress[]
  approvals         DailyActivityApproval[]

  @@index([activityType])
  @@index([startDate])
  @@index([lastProgressDate])
  @@index([status])
  @@index([approvalStatus])
  @@index([createdBy])
  @@map("daily_activities")
}

model DailyActivityProgress {
  id                    Int      @id @default(autoincrement())
  activityId            Int      @map("activity_id")
  progressDate          DateTime @map("progress_date") @db.Date
  previousProgress      Int      @map("previous_progress")
  addedProgress         Int      @map("added_progress")
  currentProgress       Int      @map("current_progress")
  pic                   String
  notes                 String?  @db.Text
  preActivityPhotoPaths String[] @default([]) @map("pre_activity_photo_paths")
  photoPaths            String[] @default([]) @map("photo_paths")
  requestClose          Boolean  @default(false) @map("request_close")
  createdBy             Int      @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  activity DailyActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  creator  User          @relation("DailyProgressCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([progressDate])
  @@index([createdBy])
  @@map("daily_activity_progresses")
}

model DailyActivityApproval {
  id         Int                   @id @default(autoincrement())
  activityId Int                   @map("activity_id")
  decision   DailyApprovalDecision
  comment    String?               @db.Text
  actedBy    Int                   @map("acted_by")
  actedAt    DateTime              @default(now()) @map("acted_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  activity DailyActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actor    User          @relation("DailyApprovalActor", fields: [actedBy], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([actedBy])
  @@index([actedAt])
  @@map("daily_activity_approvals")
}

model PreActivityCheck {
  id                        Int      @id @default(autoincrement())
  job_name                  String
  activityDate              DateTime @map("activity_date") @db.Date
  work_location_text        String?
  heavy_equipment_name_text String?
  unit_number_text          String?
  executor_team_text        String?
  hazard_potential_text     String?
  control_step_text         String?
  apd_check                 Boolean  @default(false)
  tool_condition_check      Boolean  @default(false)
  work_area_check           Boolean  @default(false)
  tool_complete_check       Boolean  @default(false)
  work_permit_check         Boolean  @default(false)
  sop_check                 Boolean  @default(false)
  jsa_check                 Boolean  @default(false)
  lifting_plan_check        Boolean  @default(false)
  jsa_image                 String?
  checklist_image           String?
  height_permit_image       String?
  health_check              String?
  health_check_status       String?
  socialization_photo       String?
  pic                       String
  executor_signature        String?
  supervisorName            String?  @map("supervisor_name")
  supervisor_signature      String?
  createdBy                 Int      @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  creator                   User     @relation("PreActivityCheckCreator", fields: [createdBy], references: [id])

  @@index([activityDate])
  @@index([createdBy])
  @@map("pre_activity_checks")
}

model PostActivity {
  id               Int      @id @default(autoincrement())
  activityDate     DateTime @map("activity_date") @db.Date
  startTime        String   @map("start_time")
  endTime          String   @map("end_time")
  workName         String   @map("work_name")
  progressPercent  Int      @map("progress_percent")
  morningWeather   String   @map("morning_weather")
  afternoonWeather String   @map("afternoon_weather")
  eveningWeather   String   @map("evening_weather")
  coordinatorCount Int      @default(1) @map("coordinator_count")
  carpenterCount   Int      @default(1) @map("carpenter_count")
  helperCount      Int      @default(1) @map("helper_count")
  approverName     String   @default("ARIEF RAHIM") @map("approver_name")
  photoPaths       String[] @default([]) @map("photo_paths")
  createdBy        Int      @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  creator          User     @relation("PostActivityCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([activityDate])
  @@index([createdBy])
  @@map("post_activities")
}

model P5mMeeting {
  id                 Int      @id @default(autoincrement())
  activityDate       DateTime @map("activity_date") @db.Date
  startTime          String   @default("00:00") @map("start_time")
  endTime            String?  @map("end_time")
  location           String
  topic              String   @db.Text
  speaker            String?
  participants       String?  @db.Text
  supervisors        Json     @default("[]")
  supervisorName     String   @default("") @map("supervisor_name")
  supervisorSignPath String?  @map("supervisor_sign_path")
  participantNames   String[] @default([]) @map("participant_names")
  documentationPaths String[] @default([]) @map("documentation_paths")
  notes              String?  @db.Text
  createdBy          Int      @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creator User @relation("P5mMeetingCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([activityDate])
  @@index([supervisorName])
  @@index([createdBy])
  @@map("p5m_meetings")
}

model PreActivity {
  id                        Int      @id @default(autoincrement())
  job_name                  String
  activityDate              DateTime @map("activity_date") @db.Date
  work_location_text        String?
  heavy_equipment_name_text String?
  unit_number_text          String?
  executor_team_text        String?
  hazard_potential_text     String?
  control_step_text         String?
  apd_check                 Boolean  @default(false)
  tool_condition_check      Boolean  @default(false)
  work_area_check           Boolean  @default(false)
  tool_complete_check       Boolean  @default(false)
  work_permit_check         Boolean  @default(false)
  sop_check                 Boolean  @default(false)
  jsa_check                 Boolean  @default(false)
  lifting_plan_check        Boolean  @default(false)
  jsa_image                 String?
  checklist_image           String?
  height_permit_image       String?
  health_check              String?
  health_check_status       String?
  socialization_photo       String?
  pic                       String
  executor_signature        String?
  supervisorName            String?  @map("supervisor_name")
  supervisor_signature      String?
  createdBy                 Int      @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  creator                   User     @relation("PreActivityCreator", fields: [createdBy], references: [id])

  @@index([activityDate])
  @@index([createdBy])
  @@map("pre_activities")
}

model CoordinatorSignature {
  id        Int      @id @default(autoincrement())
  name      String
  filePath  String   @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("coordinator_signatures")
}

model SafetyMeeting {
  id                 Int      @id @default(autoincrement())
  meetingDate        DateTime @map("meeting_date") @db.Date
  location           String?
  speaker            String?
  participants       String?
  material           String
  supervisors        Json     @default("[]")
  documentationPaths Json     @default("[]") @map("documentation_paths")
  createdBy          Int      @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([meetingDate])
  @@map("safety_meetings")
}

model TransportRecord {
  id           Int      @id @default(autoincrement())
  unitNumber   String   @map("unit_number")
  department   String
  vehicleType  String   @default("LV") @map("vehicle_type")
  fuelDate     DateTime @map("fuel_date") @db.Date
  hmStart      Decimal  @map("hm_start") @db.Decimal(14, 2)
  hmEnd        Decimal  @map("hm_end") @db.Decimal(14, 2)
  totalHm      Decimal  @default(0) @map("total_hm") @db.Decimal(14, 2)
  hmPerShift   Decimal  @default(0) @map("hm_per_shift") @db.Decimal(14, 2)
  kmPerLiter   Decimal  @default(0) @map("km_per_liter") @db.Decimal(14, 2)
  totalLiter   Decimal  @map("total_liter") @db.Decimal(14, 2)
  lostTimeBd   Decimal  @default(0) @map("lost_time_bd") @db.Decimal(14, 2)
  targetUa     Decimal  @default(0) @map("target_ua") @db.Decimal(14, 2)
  actualUa     Decimal  @default(0) @map("actual_ua") @db.Decimal(14, 2)
  uaPercentage Decimal  @default(0) @map("ua_percentage") @db.Decimal(8, 2)
  unitStatus   String   @default("READY") @map("unit_status")
  achievement  String   @default("TERCAPAI")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  creator      User     @relation("TransportRecordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([fuelDate])
  @@index([unitNumber])
  @@index([department])
  @@index([createdBy])
  @@map("transport_records")
}

// ==================================================
// ORDER PACK MEAL
// ==================================================

model PackMealOrder {
  id               Int      @id @default(autoincrement())
  orderNumber      String   @unique @map("order_number")
  orderDate        DateTime @map("order_date") @db.Date
  sequenceNumber   Int      @map("sequence_number")
  neededDate       DateTime @map("needed_date") @db.Date
  deliveryLocation String   @map("delivery_location")
  department       String?
  contactNumber    String?  @map("contact_number")
  deliveryTime     String?  @map("delivery_time")
  notes            String?  @db.Text
  approvedFormPath String   @map("approved_form_path")
  totalPacks       Int      @default(0) @map("total_packs")
  createdBy        Int      @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  creator User                @relation("PackMealOrderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items   PackMealOrderItem[]

  @@unique([orderDate, sequenceNumber])
  @@index([orderDate])
  @@index([neededDate])
  @@index([createdBy])
  @@map("pack_meal_orders")
}

model PackMealOrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  orderType String   @map("order_type")
  quantity  Int
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order PackMealOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pack_meal_order_items")
}

// ==================================================
// DEKLARASI DINAS MODULE
// ==================================================

enum JenisDeklarasi {
  PERJALANAN_DINAS
  UANG_OPERASIONAL
}

enum StatusDeklarasi {
  DRAFT
  DIAJUKAN
  DIVERIFIKASI
  DISETUJUI
  DITOLAK
}

model Deklarasi {
  id              Int             @id @default(autoincrement())
  kodeDeklarasi   String          @unique @map("kode_deklarasi") @db.VarChar(80)
  idPengguna      Int             @map("id_pengguna")
  idSaldo         Int?            @map("id_saldo")
  nrp             String          @map("nrp") @db.VarChar(50)
  namaPengguna    String          @map("nama_pengguna") @db.VarChar(120)
  jenisDeklarasi  JenisDeklarasi  @map("jenis_deklarasi")
  tanggalKegiatan DateTime        @map("tanggal_kegiatan") @db.Date
  lokasi          String          @map("lokasi") @db.VarChar(150)
  keterangan      String          @map("keterangan") @db.Text
  nomorStd        String?         @map("nomor_std") @db.VarChar(120)
  totalNominal    Decimal         @default(0) @map("total_nominal") @db.Decimal(15, 2)
  status          StatusDeklarasi @default(DRAFT)
  createdAt       DateTime        @default(now()) @map("dibuat_pada")
  updatedAt       DateTime        @updatedAt @map("diperbarui_pada")

  @@map("deklarasi")
}

enum KategoriNota {
  MAKAN
  AKOMODASI
  TRANSPORTASI
  LAUNDRY
  DANA_OPERASIONAL_W1
  DANA_OPERASIONAL_W2
  DANA_OPERASIONAL_BOD
  DANA_OPERASIONAL_BYD
  DANA_OPERASIONAL_KHUSUS
}

enum StatusVerifikasiNota {
  BELUM_OCR
  OCR_SELESAI
  DIVERIFIKASI
  DITOLAK
}

model Nota {
  id                   Int                  @id @default(autoincrement())
  idDeklarasi          Int                  @map("id_deklarasi")
  kategoriNota         KategoriNota?        @map("kategori_nota")
  barangJasa           String?              @map("barang_jasa") @db.VarChar(255)
  picSettlement        String?              @map("pic_settlement") @db.VarChar(150)
  keteranganSettlement String?              @map("keterangan_settlement") @db.Text
  jumlahItemSettlement Int                  @default(1) @map("jumlah_item_settlement")
  namaFile             String               @map("nama_file") @db.VarChar(180)
  pathFile             String               @map("path_file") @db.VarChar(255)
  hasilOcrText         String?              @map("hasil_ocr_text") @db.Text
  nominalOcr           Decimal              @default(0) @map("nominal_ocr") @db.Decimal(15, 2)
  nominalFinal         Decimal              @default(0) @map("nominal_final") @db.Decimal(15, 2)
  apakahDikoreksi      Boolean              @default(false) @map("apakah_dikoreksi")
  alasanKoreksi        String?              @map("alasan_koreksi") @db.Text
  statusVerifikasi     StatusVerifikasiNota @default(BELUM_OCR) @map("status_verifikasi")
  createdAt            DateTime             @default(now()) @map("dibuat_pada")
  updatedAt            DateTime             @updatedAt @map("diperbarui_pada")

  @@map("nota")
}

enum StatusDataDatabaseSettlement {
  AKTIF
  DIBATALKAN
}

model DatabaseSettlement {
  id               Int                          @id @default(autoincrement())
  idDeklarasi      Int                          @map("id_deklarasi")
  idSaldo          Int?                         @map("id_saldo")
  idPengguna       Int                          @map("id_pengguna")
  kodeJanganDiubah String                       @map("kode_jangan_diubah") @db.VarChar(50)
  nomorSettlement  String                       @map("nomor_settlement") @db.VarChar(50)
  item             Int                          @map("item")
  itemSett         String                       @map("item_sett") @db.VarChar(50)
  department       String                       @default("HCGA") @map("department") @db.VarChar(120)
  tanggalPembuatan DateTime                     @map("tanggal_pembuatan") @db.Date
  tanggalPerItem   DateTime                     @map("tanggal_per_item") @db.Date
  namaBarangJasa   String                       @map("nama_barang_jasa") @db.VarChar(255)
  qty              Decimal                      @default(1) @map("qty") @db.Decimal(15, 2)
  hargaPerQty      Decimal                      @default(0) @map("harga_per_qty") @db.Decimal(15, 2)
  total            Decimal                      @default(0) @map("total") @db.Decimal(15, 2)
  keterangan       String?                      @map("keterangan") @db.Text
  costCenter       String                       @default("HCGA") @map("cost_center") @db.VarChar(120)
  nomorRabPb       String?                      @map("nomor_rab_pb") @db.VarChar(160)
  pic              String?                      @map("pic") @db.VarChar(150)
  statusData       StatusDataDatabaseSettlement @default(AKTIF) @map("status_data")
  createdAt        DateTime                     @default(now()) @map("dibuat_pada")
  updatedAt        DateTime                     @updatedAt @map("diperbarui_pada")

  @@unique([idDeklarasi, item])
  @@map("database_settlement")
}

enum StatusSaldo {
  AKTIF
  PAS
  ADA_SISA
  MELEBIHI_NOMINAL
  MENUNGGU_PENGEMBALIAN
  SELESAI
}

enum StatusBuktiPengembalian {
  BELUM_UPLOAD
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

model Saldo {
  id                             Int                     @id @default(autoincrement())
  idPengguna                     Int                     @map("id_pengguna")
  nrp                            String                  @map("nrp")
  namaPengguna                   String                  @map("nama_pengguna")
  lokasi                         String?                 @map("lokasi") @db.VarChar(120)
  jenisSaldo                     JenisDeklarasi          @map("jenis_saldo")
  nominalTransfer                Decimal                 @default(0) @map("nominal_transfer") @db.Decimal(15, 2)
  totalPenggunaan                Decimal                 @default(0) @map("total_penggunaan") @db.Decimal(15, 2)
  sisaSaldo                      Decimal                 @default(0) @map("sisa_saldo") @db.Decimal(15, 2)
  nominalPengembalian            Decimal                 @default(0) @map("nominal_pengembalian") @db.Decimal(15, 2)
  tanggalTransfer                DateTime                @map("tanggal_transfer") @db.Date
  keterangan                     String?                 @map("keterangan") @db.Text
  nomorStd                       String?                 @map("nomor_std") @db.VarChar(120)
  statusSaldo                    StatusSaldo             @default(AKTIF) @map("status_saldo")
  namaFileBuktiPengembalian      String?                 @map("nama_file_bukti_pengembalian") @db.VarChar(255)
  pathFileBuktiPengembalian      String?                 @map("path_file_bukti_pengembalian") @db.VarChar(255)
  statusBuktiPengembalian        StatusBuktiPengembalian @default(BELUM_UPLOAD) @map("status_bukti_pengembalian")
  alasanBuktiPengembalianDitolak String?                 @map("alasan_bukti_pengembalian_ditolak") @db.Text
  tanggalUploadBuktiPengembalian DateTime?               @map("tanggal_upload_bukti_pengembalian") @db.Timestamp
  tanggalVerifikasiPengembalian  DateTime?               @map("tanggal_verifikasi_pengembalian") @db.Timestamp
  createdAt                      DateTime                @default(now()) @map("dibuat_pada")
  updatedAt                      DateTime                @updatedAt @map("diperbarui_pada")

  @@map("saldo")
}

enum StatusPengajuan {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  MENUNGGU_TRANSFER
  SELESAI
}

model Pengajuan {
  id                    Int             @id @default(autoincrement())
  idPengguna            Int             @map("id_pengguna")
  nrp                   String          @map("nrp") @db.VarChar(50)
  namaPengguna          String          @map("nama_pengguna") @db.VarChar(150)
  jenisPengajuan        JenisDeklarasi  @default(PERJALANAN_DINAS) @map("jenis_pengajuan")
  lokasi                String?         @map("lokasi") @db.VarChar(120)
  keterangan            String?         @map("keterangan") @db.Text
  nomorStd              String?         @map("nomor_std") @db.VarChar(120)
  nomorRab              String?         @map("nomor_rab") @db.VarChar(120)
  namaFileStd           String?         @map("nama_file_std") @db.VarChar(255)
  pathFileStd           String?         @map("path_file_std") @db.VarChar(255)
  namaFileRab           String          @map("nama_file_rab") @db.VarChar(255)
  pathFileRab           String          @map("path_file_rab") @db.VarChar(255)
  nominalTransfer       Decimal         @default(0) @map("nominal_transfer") @db.Decimal(15, 2)
  namaFileBuktiTransfer String?         @map("nama_file_bukti_transfer") @db.VarChar(255)
  pathFileBuktiTransfer String?         @map("path_file_bukti_transfer") @db.VarChar(255)
  tanggalTransfer       DateTime?       @map("tanggal_transfer") @db.Date
  idSaldo               Int?            @map("id_saldo")
  statusPengajuan       StatusPengajuan @default(DIAJUKAN) @map("status_pengajuan")
  catatanAdmin          String?         @map("catatan_admin") @db.Text
  tanggalPengajuan      DateTime        @map("tanggal_pengajuan") @db.Date
  createdAt             DateTime        @default(now()) @map("dibuat_pada")
  updatedAt             DateTime        @updatedAt @map("diperbarui_pada")

  @@map("pengajuan")
}

// ==================================================
// MCU PERIODIK
// Digitalisasi monitoring Medical Check Up periodik.
// Referensi alur: alur-workflow-mcu-periodik-v3.md
// ==================================================

enum StatusKerja {
  AKTIF
  DIRUMAHKAN
  RESIGN
}

// Dirumahkan melewati FIT dua tahap: FIT atas sakitnya, lalu FIT MCU lengkap.
enum StatusKesehatanDirumahkan {
  SAKIT
  FIT_SAKIT
}

enum JenisMcu {
  AWAL
  BERKALA
  KHUSUS
}

enum StatusPendaftaran {
  DRAFT
  TERKUNCI
  SELESAI
  DIBATALKAN
}

enum StatusSuratPengantar {
  DRAFT
  TERKIRIM
}

enum StatusReview {
  MENUNGGU
  DIREVIEW
  SELESAI
}

enum StatusRekomendasi {
  FIT
  FOLLOW_UP
}

// Keputusan #3: seluruh biaya FU ditanggung karyawan.
enum PosBiayaFollowUp {
  MANDIRI
}

enum StatusFollowUp {
  MENUNGGU_TANGGAL
  TERJADWAL
  TERLAKSANA
  TERLAMBAT_RESCHEDULE
  SELESAI
}

enum TipePengunggah {
  KARYAWAN
  KLINIK_TERKONEKSI
  HC
  ADMIN_DEPT
}

enum StatusInduksiUlang {
  MENUNGGU
  TERJADWAL
  SELESAI
}

enum TipeNotifikasiMcu {
  REMINDER_H3_BULAN
  JADWAL_MCU
  REKOMENDASI_FIT_FU
  PILIHAN_TANGGAL_FU
  REMINDER_FU_ULANG
  HASIL_FU
  INDUKSI_ULANG
}

enum KanalNotifikasi {
  EMAIL_OUTLOOK
  IN_APP
}

enum StatusKirimNotifikasi {
  MENUNGGU
  TERKIRIM
  GAGAL
}

// --------------------------------------------------
// DEPARTEMEN
// --------------------------------------------------

model Departemen {
  id             Int      @id @default(autoincrement())
  namaDepartemen String   @unique @map("nama_departemen")
  adminAkunId    Int?     @map("admin_akun_id")
  aktif          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  adminAkun    User?          @relation("AdminDepartemen", fields: [adminAkunId], references: [id], onDelete: SetNull)
  karyawan     Karyawan[]
  jadwalMcu    JadwalMcu[]
  induksiUlang InduksiUlang[]

  @@index([adminAkunId])
  @@map("departemen")
}

// --------------------------------------------------
// KARYAWAN
// tanggal_mcu_berikutnya = tanggal_mcu_expired - 3 bulan (pemicu reminder)
// --------------------------------------------------

model Karyawan {
  id                        Int                        @id @default(autoincrement())
  nik                       String                     @unique
  nama                      String
  departemenId              Int                        @map("departemen_id")
  jabatan                   String?
  email                     String?
  noTelepon                 String?                    @map("no_telepon")
  tanggalLahir              DateTime?                  @map("tanggal_lahir") @db.Date
  tanggalMcuTerakhir        DateTime?                  @map("tanggal_mcu_terakhir") @db.Date
  tanggalMcuExpired         DateTime?                  @map("tanggal_mcu_expired") @db.Date
  tanggalMcuBerikutnya      DateTime?                  @map("tanggal_mcu_berikutnya") @db.Date
  statusKerja               StatusKerja                @default(AKTIF) @map("status_kerja")
  statusKesehatanDirumahkan StatusKesehatanDirumahkan? @map("status_kesehatan_dirumahkan")
  akunId                    Int?                       @unique @map("akun_id")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")

  departemen   Departemen     @relation(fields: [departemenId], references: [id], onDelete: Restrict)
  akun         User?          @relation(fields: [akunId], references: [id], onDelete: SetNull)
  jadwalMcu    JadwalMcu[]
  followUp     FollowUp[]
  induksiUlang InduksiUlang[]

  @@index([departemenId])
  @@index([statusKerja])
  @@index([tanggalMcuBerikutnya])
  @@index([tanggalMcuExpired])
  @@map("karyawan")
}

// --------------------------------------------------
// KLINIK
// Klinik terkoneksi punya akun & bisa submit hasil sendiri.
// --------------------------------------------------

model Klinik {
  id          Int      @id @default(autoincrement())
  namaKlinik  String   @map("nama_klinik")
  alamat      String?  @db.Text
  picKlinik   String?  @map("pic_klinik")
  terkoneksi  Boolean  @default(false)
  akunId      Int?     @map("akun_id")
  statusAktif Boolean  @default(true) @map("status_aktif")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  akun           User?            @relation("AkunKlinik", fields: [akunId], references: [id], onDelete: SetNull)
  jadwalMcu      JadwalMcu[]
  suratPengantar SuratPengantar[]
  followUp       FollowUp[]

  @@index([terkoneksi])
  @@index([statusAktif])
  @@map("klinik")
}

// --------------------------------------------------
// JADWAL MCU
// tanggal_lock = tanggal_mcu - 3 hari; setelah terkunci hanya HC yang boleh ubah.
// --------------------------------------------------

model JadwalMcu {
  id                Int               @id @default(autoincrement())
  karyawanId        Int               @map("karyawan_id")
  departemenId      Int               @map("departemen_id")
  tanggalMcu        DateTime          @map("tanggal_mcu") @db.Date
  jenisMcu          JenisMcu          @default(BERKALA) @map("jenis_mcu")
  jenisPemeriksaan  String?           @map("jenis_pemeriksaan")
  klinikId          Int?              @map("klinik_id")
  suratPengantarId  Int?              @map("surat_pengantar_id")
  statusPendaftaran StatusPendaftaran @default(DRAFT) @map("status_pendaftaran")
  tanggalLock       DateTime          @map("tanggal_lock") @db.Date
  catatan           String?           @db.Text
  diubahOlehHcId    Int?              @map("diubah_oleh_hc_id")
  diubahOlehHcAt    DateTime?         @map("diubah_oleh_hc_at")
  alasanPerubahanHc String?           @map("alasan_perubahan_hc") @db.Text
  dibatalkanAt      DateTime?         @map("dibatalkan_at")
  dibuatOlehId      Int               @map("dibuat_oleh_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  karyawan       Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  departemen     Departemen      @relation(fields: [departemenId], references: [id], onDelete: Restrict)
  klinik         Klinik?         @relation(fields: [klinikId], references: [id], onDelete: SetNull)
  diubahOlehHc   User?           @relation("PengubahJadwalMcu", fields: [diubahOlehHcId], references: [id], onDelete: SetNull)
  dibuatOleh     User            @relation("PembuatJadwalMcu", fields: [dibuatOlehId], references: [id], onDelete: Restrict)
  suratPengantar SuratPengantar? @relation(fields: [suratPengantarId], references: [id], onDelete: SetNull)
  hasilMcu       HasilMcu?

  @@index([karyawanId])
  @@index([departemenId])
  @@index([tanggalMcu])
  @@index([statusPendaftaran])
  @@index([jenisMcu])
  @@index([suratPengantarId])
  @@map("jadwal_mcu")
}

// --------------------------------------------------
// SURAT PENGANTAR MCU (diterbitkan HC)
// Satu surat bisa mencakup beberapa Jadwal MCU sekaligus (batch ke
// satu klinik tujuan yang sama), mengikuti format PPA-ADR-F-HCGA.
// Surat pengantar FU tidak ada di sini - FU memakai surat rujukan Dokter.
// --------------------------------------------------

model SuratPengantar {
  id            Int                  @id @default(autoincrement())
  nomorSurat    String               @unique @map("nomor_surat")
  nomorUrut     Int                  @map("nomor_urut")
  tahunTerbit   Int                  @map("tahun_terbit")
  klinikId      Int?                 @map("klinik_id")
  tanggalTerbit DateTime             @map("tanggal_terbit") @db.Date
  catatan       String?              @db.Text
  filePdf       String?              @map("file_pdf")
  status        StatusSuratPengantar @default(DRAFT)
  tanggalKirim  DateTime?            @map("tanggal_kirim")
  diterbitkanId Int                  @map("diterbitkan_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  jadwalMcu   JadwalMcu[]
  klinik      Klinik?     @relation(fields: [klinikId], references: [id], onDelete: SetNull)
  diterbitkan User        @relation("PenerbitSuratPengantar", fields: [diterbitkanId], references: [id], onDelete: Restrict)

  @@unique([tahunTerbit, nomorUrut])
  @@index([status])
  @@index([tanggalTerbit])
  @@map("surat_pengantar")
}

// --------------------------------------------------
// HASIL MCU (file mentah - hanya HC & Dokter)
// retensi_hapus_at = tanggal_upload + 6 bulan
// --------------------------------------------------

model HasilMcu {
  id             Int            @id @default(autoincrement())
  jadwalMcuId    Int            @unique @map("jadwal_mcu_id")
  tanggalUpload  DateTime       @default(now()) @map("tanggal_upload")
  diunggahOlehId Int            @map("diunggah_oleh_id")
  tipePengunggah TipePengunggah @map("tipe_pengunggah")
  fileHasilMcu   String         @map("file_hasil_mcu")
  namaFileAsli   String?        @map("nama_file_asli")
  statusReview   StatusReview   @default(MENUNGGU) @map("status_review")
  retensiHapusAt DateTime       @map("retensi_hapus_at") @db.Date
  fileDihapusAt  DateTime?      @map("file_dihapus_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  jadwalMcu    JadwalMcu        @relation(fields: [jadwalMcuId], references: [id], onDelete: Cascade)
  diunggahOleh User             @relation("PengunggahHasilMcu", fields: [diunggahOlehId], references: [id], onDelete: Restrict)
  rekomendasi  RekomendasiMcu[]

  @@index([statusReview])
  @@index([retensiHapusAt])
  @@index([tanggalUpload])
  @@map("hasil_mcu")
}

// --------------------------------------------------
// REKOMENDASI MCU (Dokter)
// Jika FU, Dokter sekaligus menerbitkan surat rujukan FU.
// --------------------------------------------------

model RekomendasiMcu {
  id                     Int               @id @default(autoincrement())
  hasilMcuId             Int               @map("hasil_mcu_id")
  hasilFollowUpAsalId    Int?              @unique @map("hasil_follow_up_asal_id")
  dokterId               Int               @map("dokter_id")
  status                 StatusRekomendasi
  catatanMedisTerbatas   String?           @map("catatan_medis_terbatas") @db.Text
  filePdfRekomendasi     String?           @map("file_pdf_rekomendasi")
  suratRujukanFu         String?           @map("surat_rujukan_fu")
  nomorSuratRujukan      String?           @unique @map("nomor_surat_rujukan")
  siklusKe               Int               @default(1) @map("siklus_ke")
  tanggalSubmit          DateTime          @default(now()) @map("tanggal_submit")
  diteruskanKeDeptAt     DateTime?         @map("diteruskan_ke_dept_at")
  diteruskanKeKaryawanAt DateTime?         @map("diteruskan_ke_karyawan_at")
  diteruskanOlehId       Int?              @map("diteruskan_oleh_id")
  retensiHapusAt         DateTime          @map("retensi_hapus_at") @db.Date
  fileDihapusAt          DateTime?         @map("file_dihapus_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  hasilMcu          HasilMcu       @relation(fields: [hasilMcuId], references: [id], onDelete: Cascade)
  hasilFollowUpAsal HasilFollowUp? @relation("RekomendasiDariHasilFu", fields: [hasilFollowUpAsalId], references: [id], onDelete: SetNull)
  dokter            User           @relation("DokterRekomendasi", fields: [dokterId], references: [id], onDelete: Restrict)
  followUp          FollowUp?
  induksiUlang      InduksiUlang?

  @@index([hasilMcuId])
  @@index([status])
  @@index([tanggalSubmit])
  @@index([retensiHapusAt])
  @@map("rekomendasi_mcu")
}

// --------------------------------------------------
// FOLLOW UP
// Biaya selalu mandiri; batas waktu ditetapkan HC manual
// (maksimal 2 bulan setelah MCU ulang).
// --------------------------------------------------

model FollowUp {
  id                     Int              @id @default(autoincrement())
  rekomendasiId          Int              @unique @map("rekomendasi_id")
  karyawanId             Int              @map("karyawan_id")
  posBiaya               PosBiayaFollowUp @default(MANDIRI) @map("pos_biaya")
  batasWaktuFu           DateTime?        @map("batas_waktu_fu") @db.Date
  ditetapkanOlehHcId     Int?             @map("ditetapkan_oleh_hc_id")
  ditetapkanAt           DateTime?        @map("ditetapkan_at")
  tanggalPilihanKaryawan DateTime?        @map("tanggal_pilihan_karyawan") @db.Date
  klinikId               Int?             @map("klinik_id")
  status                 StatusFollowUp   @default(MENUNGGU_TANGGAL)
  jumlahReminderHc       Int              @default(0) @map("jumlah_reminder_hc")
  reminderTerakhirAt     DateTime?        @map("reminder_terakhir_at")
  siklusKe               Int              @default(1) @map("siklus_ke")
  ditutupAt              DateTime?        @map("ditutup_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  rekomendasi    RekomendasiMcu  @relation(fields: [rekomendasiId], references: [id], onDelete: Cascade)
  karyawan       Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  ditetapkanOleh User?           @relation("PenetapBatasFollowUp", fields: [ditetapkanOlehHcId], references: [id], onDelete: SetNull)
  klinik         Klinik?         @relation(fields: [klinikId], references: [id], onDelete: SetNull)
  hasilFollowUp  HasilFollowUp[]

  @@index([karyawanId])
  @@index([status])
  @@index([batasWaktuFu])
  @@map("follow_up")
}

// --------------------------------------------------
// HASIL FOLLOW UP
// Direview ulang -> melahirkan RekomendasiMcu baru (loop sampai FIT).
// --------------------------------------------------

model HasilFollowUp {
  id             Int            @id @default(autoincrement())
  followUpId     Int            @map("follow_up_id")
  tanggalSubmit  DateTime       @default(now()) @map("tanggal_submit")
  diunggahOlehId Int            @map("diunggah_oleh_id")
  tipePengunggah TipePengunggah @map("tipe_pengunggah")
  fileHasilFu    String         @map("file_hasil_fu")
  namaFileAsli   String?        @map("nama_file_asli")
  statusReview   StatusReview   @default(MENUNGGU) @map("status_review")
  retensiHapusAt DateTime       @map("retensi_hapus_at") @db.Date
  fileDihapusAt  DateTime?      @map("file_dihapus_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  followUp        FollowUp        @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  diunggahOleh    User            @relation("PengunggahHasilFollowUp", fields: [diunggahOlehId], references: [id], onDelete: Restrict)
  rekomendasiBaru RekomendasiMcu? @relation("RekomendasiDariHasilFu")

  @@index([followUpId])
  @@index([statusReview])
  @@index([retensiHapusAt])
  @@map("hasil_follow_up")
}

// --------------------------------------------------
// INDUKSI ULANG (didaftarkan Admin Dept, dilaksanakan SHE)
// --------------------------------------------------

model InduksiUlang {
  id                 Int                @id @default(autoincrement())
  karyawanId         Int                @map("karyawan_id")
  rekomendasiPemicId Int                @unique @map("rekomendasi_pemicu_id")
  departemenId       Int                @map("departemen_id")
  tanggalDaftar      DateTime           @default(now()) @map("tanggal_daftar")
  tanggalPelaksanaan DateTime?          @map("tanggal_pelaksanaan") @db.Date
  status             StatusInduksiUlang @default(MENUNGGU)
  sheId              Int?               @map("she_id")
  catatan            String?            @db.Text
  selesaiAt          DateTime?          @map("selesai_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  karyawan         Karyawan       @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  rekomendasiPemic RekomendasiMcu @relation(fields: [rekomendasiPemicId], references: [id], onDelete: Cascade)
  departemen       Departemen     @relation(fields: [departemenId], references: [id], onDelete: Restrict)
  she              User?          @relation("PicSheInduksi", fields: [sheId], references: [id], onDelete: SetNull)

  @@index([karyawanId])
  @@index([status])
  @@index([tanggalDaftar])
  @@map("induksi_ulang")
}

// --------------------------------------------------
// LOG NOTIFIKASI MCU
// --------------------------------------------------

model LogNotifikasiMcu {
  id            Int                   @id @default(autoincrement())
  tipe          TipeNotifikasiMcu
  refTabel      String                @map("ref_tabel")
  refId         Int                   @map("ref_id")
  penerimaId    Int?                  @map("penerima_id")
  penerimaEmail String?               @map("penerima_email")
  judul         String
  pesan         String                @db.Text
