/**
 * namaPekerjaan diketik manual oleh vendor tiap input (tanpa daftar master WBS).
 * Deviasi (actual - planned) dihitung on-the-fly, tidak disimpan sebagai kolom fisik.
 */
model ProgressMingguan {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  mingguKe      Int      @map("minggu_ke")
  namaPekerjaan String   @map("nama_pekerjaan")
  planned       Decimal  @map("planned_persen") @db.Decimal(5, 2)
  actual        Decimal  @map("actual_persen") @db.Decimal(5, 2)
  fileUrl       String?  @map("file_url")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("eprom_progress_mingguan")
}

